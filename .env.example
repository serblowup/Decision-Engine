# Decision Engine configuration — defaults match src/config.py.
# Copy to .env and override per environment.

# --- Kafka / VictoriaMetrics / PostgreSQL ---------------------------------
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TASKS_TOPIC=reconfig.tasks
VICTORIAMETRICS_URL=http://victoriametrics:8428
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@postgres/admin_panel

# --- Decision policy ------------------------------------------------------
METRICS_POLL_INTERVAL_SEC=60
PERIODIC_INTERVAL_SECONDS=60
ANOMALY_THRESHOLD=3.0
BANDWIDTH_THRESHOLD=0.85
TRIGGER_CHANGE_PERCENT=0.2
ICMP_THRESHOLD=1000.0
NEW_SOURCES_THRESHOLD=10
INTER_VLAN_RATIO_THRESHOLD=0.4
MAX_FLOW_BYTES_THRESHOLD=100000000
MERGE_MIN_INTER_VLAN_BYTES_PER_SEC=1000000.0
DEDUP_WAITING_TIMEOUT_SEC=600

# --- Quarantine VLAN (validated to [2, 4094]) ----------------------------
QUARANTINE_VLAN=999
FALLBACK_VLAN_ID=1

# --- Anomaly-detector guards (Defect 1) ---------------------------------
# Minimum window size before z-score is computed; defends against cold-start
# false positives where a tiny window has near-zero std.
ANOMALY_MIN_WINDOW_SIZE=10
# Lower bound on pstdev(window) below which z-score returns 0.0 (the window
# is effectively constant, e.g. all zeros).
ANOMALY_MIN_STD_THRESHOLD=1e-6
# Lower bound on the window's mean. In a low-volume regime (mean ~= 1, std
# ~= 1) a single small deviation produces a disproportionately large z-score;
# values below this threshold suppress the score (defect 4).
ANOMALY_MIN_BASELINE_MEAN=10.0

# --- Initial topology sync gate ------------------------------------------
WAIT_FOR_INITIAL_SYNC=true
SYNC_WAIT_TIMEOUT_SECONDS=120
SYNC_POLL_INTERVAL_SECONDS=5
SYNC_MAX_AGE_SECONDS=0
SYNC_WAIT_TIMEOUT_BEHAVIOR=proceed

# --- Subinterface provisioning -------------------------------------------
SUBINTERFACE_PARENT=GigabitEthernet0/0/1
SUBINTERFACE_SUBNET_TEMPLATE=192.168.{vlan_id}.1/24
SUBINTERFACE_ENABLED=true

# --- Segmenter ------------------------------------------------------------
SEGMENTER_TYPE=greedy
GREEDY_MAX_ITERATIONS=100
LAMBDA_COEFF=0.5
SA_INITIAL_TEMPERATURE=100.0
SA_COOLING_RATE=0.95
SA_MAX_ITERATIONS=1000

LINK_CAPACITY_MBPS=1000
LOG_LEVEL=INFO
